# TriAgent backend environment variables
# Copy to backend/.env and fill in your values.
# For Docker deployments, use infra/.env instead (infra/.env.template).

# DeepSeek — required for cloud backbone (deepseek-chat)
# Get your key at: platform.deepseek.com
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# OpenWeatherMap — required for weather tool in process automation
# Free tier: openweathermap.org
OPENWEATHER_API_KEY=your_openweathermap_api_key_here

# llama.cpp server URL — used when BACKBONE_PROVIDER=llamacpp_b (local GPU backbones)
# Default matches the Docker service name; change if running the server elsewhere.
LLAMACPP_B_BASE_URL=http://localhost:8080/v1

# Backbone selection (overrides defaults in config/settings.py)
# BACKBONE=deepseek-chat
# BACKBONE_PROVIDER=deepseek
# ABLATION_MODE=full
