# TriAgent environment variables

# OpenAI — GPT-4o for TriAgent-GPT + embeddings (text-embedding-3-small)
OPENAI_API_KEY=your_openai_api_key_here

# Groq — free, LLaMA 3-70B for TriAgent-LLaMA — console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# OpenWeatherMap — free, 1000 calls/day — openweathermap.org
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Twilio SMS — optional, simulation mode if not set
TWILIO_ACCOUNT_SID=your_twilio_sid_here
TWILIO_AUTH_TOKEN=your_twilio_token_here
TWILIO_PHONE_NUMBER=+1234567890
