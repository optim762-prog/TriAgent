# ── API keys ─────────────────────────────────────────────────────────────────
DEEPSEEK_API_KEY=sk-...

# ── External tools ────────────────────────────────────────────────────────────
OPENWEATHER_API_KEY=...

# ── HuggingFace (required for llama.cpp -hf flag to download GGUF) ────────────
HUGGING_FACE_HUB_TOKEN=hf_...

# ── llama.cpp server (24 GB VRAM, default: Qwen3-27B) ────────────────────────
LCPP_MODEL_REPO=unsloth/Qwen3.6-27B-MTP-GGUF:UD-Q4_K_XL
LCPP_ALIAS=qwen-local
LCPP_CTX_SIZE=16384
LCPP_N_GPU_LAYERS=99
LCPP_N_PARALLEL=1
LCPP_TIMEOUT=1200

# ── TriAgent runtime defaults (override per-run via CLI flags) ────────────────
TRIAGENT_BACKBONE=deepseek-chat
TRIAGENT_BACKBONE_PROVIDER=deepseek
TRIAGENT_ABLATION_MODE=full
